# Local ASP.NET Core API (Kestrel, launch profile "http").
# Not a secret. A production build must set VITE_API_BASE_URL to the
# deployed origin. Vite only exposes variables that start with VITE_.
#
# The Vue dev server is http://localhost:4201. Development CORS already
# allows that origin. http://127.0.0.1:4201 is a different origin and is
# not on the allow-list. `vite preview` uses port 4300, which is also
# absent from FrontendCors:Origins.
VITE_API_BASE_URL=http://localhost:5000
