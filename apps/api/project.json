{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/BusinessMarketplace.Api",
  "tags": [],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/api/BusinessMarketplace.Api/BusinessMarketplace.Api.csproj --launch-profile http --urls http://localhost:5000",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build apps/api/BusinessMarketplace.slnx",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/api/BusinessMarketplace.slnx",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/api/BusinessMarketplace.slnx --filter Category!=Integration",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/api/BusinessMarketplace.slnx --filter Category=Integration",
        "cwd": "{workspaceRoot}"
      }
    },
    "test-coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test apps/api/BusinessMarketplace.slnx --collect:\"XPlat Code Coverage\" --results-directory apps/api/coverage",
        "cwd": "{workspaceRoot}"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/api/BusinessMarketplace.Api/BusinessMarketplace.Api.csproj --launch-profile http -- --seed",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
