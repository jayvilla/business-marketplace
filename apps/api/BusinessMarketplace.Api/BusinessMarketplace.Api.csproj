<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Microsoft.NET.Sdk.Web is the ASP.NET Core SDK: Kestrel, controllers,
    configuration, and logging. net10.0 is the target framework moniker,
    so this project compiles against .NET 10 / ASP.NET Core 10.
    Nullable enable is strictNullChecks for reference types.
    ImplicitUsings adds the common framework usings globally.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.OpenApi generates the OpenAPI document.
      Swashbuckle.AspNetCore.SwaggerUI is only the browser viewer that
      reads /openapi/v1.json. It is not a second document generator.
      Microsoft.EntityFrameworkCore and Relational are pinned to 10.0.13.
      Npgsql allows any 10.0.4 or newer, and a test project would otherwise
      bind that lower Relational assembly. Design is the migration
      tooling and stays private to this project. Npgsql is the PostgreSQL
      provider. There is no EF Core InMemory package.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BusinessMarketplace.Api.Tests" />
  </ItemGroup>

</Project>
