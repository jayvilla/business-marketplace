<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Microsoft.NET.Sdk.Web is the ASP.NET Core SDK: Kestrel, controllers,
    configuration, and logging. net10.0 is the target framework moniker,
    so this project compiles against .NET 10 / ASP.NET Core 10.
    Nullable enable is strictNullChecks for reference types.
    ImplicitUsings adds the common framework usings globally.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.AspNetCore.OpenApi generates the OpenAPI document.
      Swashbuckle.AspNetCore.SwaggerUI is only the browser viewer that
      reads /openapi/v1.json. It is not a second document generator.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

</Project>
